          "env": {
            "MERIDIAN_CONTEXT_LAYOUT": "all",
            "MERIDIAN_CHAT_TOPK": "3",
            "QUERY_HISTORY_TURNS": "1"
          },
          "note": "what serve did before 2026-09-21: excerpts of every turn stay in the context, 3 chunks a turn, the question alone as the search text"
        },
        "budget-8k": {
          "env": {
            "MERIDIAN_CONTEXT_BUDGET": "8000"
          },
          "note": "layout current with a context budget: the excerpts stay in the cached prefix until the context crosses 8k, then one clean prefill"
        },
        "budget-5k": {
          "env": {
            "MERIDIAN_CONTEXT_BUDGET": "5000"
          },
          "note": "as budget-8k, compacting twice as often"
        },
        "direct-k5": {
          "env": {
            "MERIDIAN_CHAT_ENGINE": "direct"
          },
          "note": "the direct addon engine: the cached state holds the bare conversation, this turn's excerpts live in a throwaway key (docs/todo-5.md)"
        },
        "discard-all-8k": {
          "env": {
            "MERIDIAN_CONTEXT_LAYOUT": "all",
            "MERIDIAN_CHAT_CTX": "8192",
            "MERIDIAN_CHAT_DISCARD": "2048"
          },
          "note": "the same on half the context, so the window fires from the fourth or fifth turn of a session instead of only on the longest ones"
        },
        "all-8k-nodiscard": {
          "env": {
            "MERIDIAN_CONTEXT_LAYOUT": "all",
            "MERIDIAN_CHAT_CTX": "8192"
          },
          "note": "the control for discard-all-8k: same layout and context, window off, so the turn that crosses 8192 throws context overflow and takes the session's KV state with it"
        },
        "tools-in-system": {
          "env": {
            "MERIDIAN_TOOLS_IN_SYSTEM": "1"
          },
          "note": "the tool declarations are written into the system prompt, which the prime protects, instead of being handed to the SDK; calls are read out of the model's text (docs/todo-6.md)"
        },
        "tools-in-system-discard": {
          "env": {
            "MERIDIAN_TOOLS_IN_SYSTEM": "1",
            "MERIDIAN_CONTEXT_LAYOUT": "all",
            "MERIDIAN_CHAT_CTX": "8192",
            "MERIDIAN_CHAT_DISCARD": "2048"
          },
          "note": "discard-all-8k with the declarations in the system prompt: the 439 tokens a turn the evictable block costs should go away"
        },
        "tool-window-5": {
          "env": {
            "MERIDIAN_RETRIEVAL_MODE": "tool",
            "MERIDIAN_CONTEXT_KEEP_TURNS": "5",
            "MERIDIAN_CONTEXT_BUDGET": "8000"
          },
          "note": "retrieval runs automatically for the first turn only, later turns call search_documents; the turn that crosses 8k keeps the last five exchanges and drops the rest"
        },
        "tool-window-8": {
          "env": {
            "MERIDIAN_RETRIEVAL_MODE": "tool",
            "MERIDIAN_CONTEXT_KEEP_TURNS": "8",
            "MERIDIAN_CONTEXT_BUDGET": "8000"
          },
          "note": "the same with a window of eight exchanges"
        },
        "tool-window-5-tight": {
          "env": {
            "MERIDIAN_RETRIEVAL_MODE": "tool",
            "MERIDIAN_CONTEXT_KEEP_TURNS": "5",
            "MERIDIAN_CONTEXT_BUDGET": "2800"
          },
          "note": "tool-window-5 with a budget the bare history actually reaches, so the window fires: without tool rounds a fifteen-turn replay is only about 2400 tokens and 8000 is never crossed"
        },
        "agent-loop-12k": {
          "env": {
            "MERIDIAN_RETRIEVAL_MODE": "tool",
            "MERIDIAN_CONTEXT_LAYOUT": "current",
            "MERIDIAN_CONTEXT_BUDGET": "12000",
            "MERIDIAN_CONTEXT_KEEP_MESSAGES": "10",
            "MERIDIAN_DROP_TOOL_ROUNDS": "1",
            "MERIDIAN_AGENT_PROMPT": "1"
          },
          "note": "the agent loop: retrieval through search_documents, history appended and never rewritten between compactions so the KV cache holds, and the turn that crosses 12000 drops the earlier tool rounds and keeps the last ten messages (docs/todo-8.md)"
        },
        "agent-loop-20pct": {
          "env": {
            "MERIDIAN_RETRIEVAL_MODE": "tool",
            "MERIDIAN_CONTEXT_LAYOUT": "current",
            "MERIDIAN_CONTEXT_BUDGET": "3277",
            "MERIDIAN_CONTEXT_KEEP_MESSAGES": "10",
            "MERIDIAN_DROP_TOOL_ROUNDS": "1",
            "MERIDIAN_AGENT_PROMPT": "1"
          },
          "note": "the agent loop with the budget at a literal 20% of ctx_size (3277 on M): one tool result is about 2700 tokens, so the threshold is crossed on every turn and the cache never survives one"
        },
        "config-auto": {
          "env": {
            "MERIDIAN_CONTEXT_LAYOUT": "current",
            "MERIDIAN_CONTEXT_BUDGET": "26214",
            "MERIDIAN_CONTEXT_KEEP_MESSAGES": "10",
            "MERIDIAN_DROP_TOOL_ROUNDS": "1",
            "MERIDIAN_CHAT_TOPK": "5",
            "MERIDIAN_RETRIEVAL_MODE": "auto"
          },
          "note": "config 1, the default, and now also what src/config.js ships: the server searches on every turn, at most five fresh chunks after the dedup; search_documents is not declared. MERIDIAN_AGENT_PROMPT is left out -- it only reaches systemPrompt when the mode is tool"
        },
        "config-tool": {
          "env": {
            "MERIDIAN_CONTEXT_LAYOUT": "current",
            "MERIDIAN_CONTEXT_BUDGET": "26214",
            "MERIDIAN_CONTEXT_KEEP_MESSAGES": "10",
            "MERIDIAN_DROP_TOOL_ROUNDS": "1",
            "MERIDIAN_AGENT_PROMPT": "1",
            "MERIDIAN_CHAT_TOPK": "5",
            "MERIDIAN_RETRIEVAL_MODE": "tool"
          },
          "note": "config 2: the model calls search_documents itself on every turn, the first included; the dedup backfills so five fresh chunks always come back"
        }
