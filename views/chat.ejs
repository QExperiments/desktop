<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Meridian Assistant</title>
    <style>
      :root { --ink: #1c1916; --muted: #5c564e; --paper: #f4efe6; --card: #fffdf9; --line: #e4dccb; --accent: #8c2f1b; }
      * { box-sizing: border-box; }
      html, body { height: 100%; margin: 0; }
      body { display: flex; flex-direction: column; font: 16px/1.5 ui-sans-serif, system-ui, sans-serif; color: var(--ink); background: var(--paper); }
      header { display: flex; align-items: center; gap: 0.75rem; padding: 0.7rem 1rem; border-bottom: 1px solid var(--line); background: var(--card); }
      header h1 { font-size: 1rem; margin: 0; }
      header .status { flex: 1; color: var(--muted); font-size: 0.8rem; }
      header a { color: var(--muted); font-size: 0.8rem; }
      button { font: inherit; border: 1px solid var(--line); background: var(--card); color: var(--ink); border-radius: 8px; padding: 0.4rem 0.8rem; cursor: pointer; }
      button.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
      button:disabled { opacity: 0.5; cursor: default; }
      main { flex: 1; overflow-y: auto; }
      .thread { max-width: 760px; margin: 0 auto; padding: 1.25rem 1rem 2rem; display: flex; flex-direction: column; gap: 1rem; }
      .msg { max-width: 85%; white-space: pre-wrap; word-break: break-word; }
      .msg.user { align-self: flex-end; background: var(--accent); color: #fff; border-radius: 16px 16px 4px 16px; padding: 0.6rem 0.9rem; }
      .msg.assistant { align-self: flex-start; }
      .cites { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.5rem; }
      .cites code { font-size: 0.75rem; background: var(--card); border: 1px solid var(--line); border-radius: 999px; padding: 0.1rem 0.55rem; }
      .empty { text-align: center; color: var(--muted); margin: 4rem 0 0.5rem; }
      .examples { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; }
      .error { color: var(--accent); font-size: 0.9rem; }
      footer { border-top: 1px solid var(--line); background: var(--card); padding: 0.75rem 1rem 0.5rem; }
      .composer { max-width: 760px; margin: 0 auto; display: flex; gap: 0.5rem; align-items: flex-end; }
      textarea { flex: 1; font: inherit; resize: none; min-height: 2.8rem; max-height: 10rem; padding: 0.6rem 0.8rem; border: 1px solid var(--line); border-radius: 12px; background: #fff; color: var(--ink); }
      textarea:focus { outline: 2px solid var(--accent); border-color: transparent; }
      .hint { max-width: 760px; margin: 0.35rem auto 0; color: var(--muted); font-size: 0.75rem; text-align: center; }
    </style>
  </head>
  <body>
    <header>
      <h1>Meridian Assistant</h1>
      <span class="status" id="status"></span>
      <a href="/ui">Test console</a>
      <button type="button" id="new">New chat</button>
    </header>
    <main id="main"><div class="thread" id="thread"></div></main>
    <footer>
      <div class="composer">
        <textarea id="q" rows="1" placeholder="Ask about the documents or stock. Enter sends, Shift+Enter is a new line."></textarea>
        <button type="button" class="primary" id="send">Send</button>
      </div>
      <p class="hint">Answers come from the ingested documents and the stock tool only; each answer lists its sources.</p>
    </footer>
    <script id="boot" type="application/json"><%- JSON.stringify(snapshot) %></script>
    <script>
      const api = <%- JSON.stringify(apiPrefix) %>
      const $ = (id) => document.getElementById(id)
      const el = (tag, className, text) => Object.assign(document.createElement(tag), { className, textContent: text ?? '' })
      const EXAMPLES = ['What is the P1 first-response SLA?', 'How many ServoDrive X4 are available in EMEA?', 'Which documents do you have?']

      // The transcript lives in the page and is sent whole, OpenAI style. The
      // session id lets the server reuse its KV state between turns.
      const newSession = () => `chat-${Date.now().toString(36)}`
      let chat = { session: newSession(), history: [] }
      let busy = false

      const paintStatus = (snapshot) => {
        $('status').textContent = snapshot.ready ? `tier ${snapshot.tier} · ${snapshot.mode}` : 'loading models…'
        $('send').disabled = busy || !snapshot.ready
        return snapshot.ready === true
      }
      const pollReady = async () => {
        try { if (paintStatus(await (await fetch('/health')).json())) return } catch {}
        setTimeout(pollReady, 2000)
      }

      const paint = (error) => {
        const thread = $('thread')
        thread.replaceChildren()
        if (!chat.history.length) {
          thread.append(el('p', 'empty', "Ask about Meridian's documents or stock."))
          const row = el('div', 'examples')
          for (const q of EXAMPLES) {
            const b = el('button', '', q)
            b.onclick = () => { $('q').value = q; send() }
            row.append(b)
          }
          thread.append(row)
        }
        for (const { role, content, citations } of chat.history) {
          const msg = el('div', `msg ${role}`, content || '…')
          if (citations?.length) {
            const row = el('div', 'cites')
            for (const cite of citations) row.append(el('code', '', cite.asOf ? `${cite.file} · as of ${cite.asOf}` : cite.file))
            msg.append(row)
          }
          thread.append(msg)
        }
        if (error) thread.append(el('p', 'error', error))
        $('main').scrollTop = $('main').scrollHeight
      }

      // OpenAI-style SSE: one JSON per `data:` line, `[DONE]` closes the stream.
      async function* sse(response) {
        const reader = response.body.getReader()
        const decoder = new TextDecoder()
        let buffer = ''
        for (;;) {
          const { value, done } = await reader.read()
          if (done) return
          buffer += decoder.decode(value, { stream: true })
          const parts = buffer.split('\n\n')
          buffer = parts.pop()
          for (const part of parts) {
            const data = part.replace(/^data: /, '')
            if (data === '[DONE]') return
            yield JSON.parse(data)
          }
        }
      }

      async function send() {
        const content = $('q').value.trim()
        if (!content || busy) return
        busy = true
        $('send').disabled = true
        const messages = [...chat.history, { role: 'user', content }].map(({ role, content }) => ({ role, content }))
        const reply = { role: 'assistant', content: '', citations: [] }
        chat.history.push({ role: 'user', content }, reply)
        $('q').value = ''
        $('q').style.height = ''
        paint()
        try {
          const response = await fetch(`${api}/chat/completions`, {
            method: 'POST',
            headers: { 'content-type': 'application/json', 'x-session-id': chat.session },
            body: JSON.stringify({ messages, stream: true }),
          })
          if (!response.ok) {
            const body = await response.json().catch(() => ({}))
            throw new Error(body.error?.message ?? `${response.status} ${response.statusText}`)
          }
          for await (const event of sse(response)) {
            if (event.error) throw new Error(event.error.message)
            const delta = event.choices?.[0]?.delta ?? {}
            if (delta.content) reply.content += delta.content
            if (delta.citations) reply.citations = delta.citations
            paint()
          }
        } catch (error) {
          chat.history.splice(-2) // the question goes back to the box to resend
          $('q').value = content
          paint(error.message)
        } finally {
          busy = false
          $('send').disabled = false
          $('q').focus()
        }
      }

      $('send').onclick = send
      $('new').onclick = () => { chat = { session: newSession(), history: [] }; paint(); $('q').focus() }
      $('q').addEventListener('keydown', (event) => {
        if (event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); send() }
      })
      $('q').addEventListener('input', () => { const q = $('q'); q.style.height = ''; q.style.height = `${Math.min(q.scrollHeight, 160)}px` })

      if (!paintStatus(JSON.parse($('boot').textContent))) pollReady()
      paint()
    </script>
  </body>
</html>
